# Copy this file to scripts/deploy.local.env and replace the placeholders.
# The local file is ignored by Git.

DEPLOY_HOST=your-ssh-host-alias
REMOTE_REPO=/path/to/remote/game-checkout
REMOTE_STACK=/path/to/remote/compose-stack

# These defaults are optional and may be omitted.
DEPLOY_BRANCH=main
SOURCE_REMOTE=forgejo
